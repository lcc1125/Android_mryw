<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/nav_graph"
            app:startDestination="@id/loginFragment">

    <!-- Authentication Fragments -->
    <fragment
            android:id="@+id/loginFragment"
            android:name="com.example.myapplication.ui.auth.LoginFragment"
            android:label="登录"
            tools:layout="@layout/fragment_login">

        <action
                android:id="@+id/action_loginFragment_to_registerFragment"
                app:destination="@id/registerFragment"/>

        <action
                android:id="@+id/action_loginFragment_to_homeFragment"
                app:destination="@id/homeFragment"
                app:popUpTo="@id/loginFragment"
                app:popUpToInclusive="true"/>
    </fragment>

    <fragment
            android:id="@+id/registerFragment"
            android:name="com.example.myapplication.ui.auth.RegisterFragment"
            android:label="注册"
            tools:layout="@layout/fragment_register">

        <action
                android:id="@+id/action_registerFragment_to_homeFragment"
                app:destination="@id/homeFragment"
                app:popUpTo="@id/loginFragment"
                app:popUpToInclusive="true"/>
    </fragment>

    <!-- Main Fragments -->
    <fragment
            android:id="@+id/homeFragment"
            android:name="com.example.myapplication.ui.home.HomeFragment"
            android:label="首页"
            tools:layout="@layout/fragment_home">

        <action
                android:id="@+id/action_homeFragment_to_practiceFragment"
                app:destination="@id/practiceFragment"/>
    </fragment>

    <fragment
            android:id="@+id/practiceFragment"
            android:name="com.example.myapplication.ui.practice.PracticeFragment"
            android:label="答题"
            tools:layout="@layout/fragment_practice">

        <argument
                android:name="questionId"
                android:defaultValue="0L"
                app:argType="long"/>

        <action
                android:id="@+id/action_practiceFragment_to_resultFragment"
                app:destination="@id/resultFragment"/>
    </fragment>

    <fragment
            android:id="@+id/resultFragment"
            android:name="com.example.myapplication.ui.result.ResultFragment"
            android:label="结果"
            tools:layout="@layout/fragment_result">

        <argument
                android:name="answerRecord"
                app:argType="com.example.myapplication.data.model.AnswerRecord"
                app:nullable="true"/>

        <action
                android:id="@+id/action_resultFragment_to_homeFragment"
                app:destination="@id/homeFragment"
                app:popUpTo="@id/homeFragment"
                app:popUpToInclusive="true"/>

        <action
                android:id="@+id/action_resultFragment_to_practiceFragment"
                app:destination="@id/practiceFragment"/>
    </fragment>

    <fragment
            android:id="@+id/statisticsFragment"
            android:name="com.example.myapplication.ui.statistics.StatisticsFragment"
            android:label="统计"
            tools:layout="@layout/fragment_statistics"/>

    <fragment
            android:id="@+id/profileFragment"
            android:name="com.example.myapplication.ui.profile.ProfileFragment"
            android:label="我的"
            tools:layout="@layout/fragment_profile">

        <action
                android:id="@+id/action_profileFragment_to_loginFragment"
                app:destination="@id/loginFragment"
                app:popUpTo="@id/nav_graph"
                app:popUpToInclusive="true"/>
    </fragment>

</navigation>
